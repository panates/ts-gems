{
  "extends": "@panates/tsconfig/node.json",
  "compilerOptions": {
    "types": ["node", "mocha"],
    "esModuleInterop": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "skipLibCheck": false,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "test"],
  "exclude": ["node_modules"]
}
